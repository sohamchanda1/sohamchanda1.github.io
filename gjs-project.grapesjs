, CFPs, archived programs, speaker lists, and related resources."}]},{"name":"Divider","classes":["divider"]},{"tagName":"p","type":"text","name":"Seminar Meta","classes":["seminar-meta"],"components":[{"type":"textnode","content":"Link placeholder"}]}]},{"type":"link","name":"Seminar Link Card","editable":false,"classes":["card-glow","group","seminar-link-card"],"attributes":{"href":"#"},"components":[{"name":"Seminar Header","classes":["seminar-header"],"components":[{"name":"Seminar Title Group","classes":["seminar-title-group"],"components":[{"tagName":"span","type":"text","name":"Seminar Label","classes":["seminar-label"],"components":[{"type":"textnode","content":"Network"}]},{"tagName":"h3","type":"heading","name":"Seminar Title","classes":["seminar-title"],"components":[{"type":"textnode","content":"Research network or initiative"}]}]},{"type":"image","name":"Link Icon","resizable":{"ratioDefault":1},"classes":["link-icon"],"attributes":{"src":"https://api.iconify.design/lucide-arrow-up-right.svg?color=%23c7e6c6","alt":""}}]},{"tagName":"p","type":"text","name":"Seminar Description","classes":["seminar-description"],"components":[{"type":"textnode","content":"A useful place for collaborative collectives, labs, institutes, or multi-campus projects."}]},{"name":"Divider","classes":["divider"]},{"tagName":"p","type":"text","name":"Seminar Meta","classes":["seminar-meta"],"components":[{"type":"textnode","content":"Link placeholder"}]}]}]}]},{"tagName":"section","name":"Travel Section","classes":["section-anchor"],"attributes":{"id":"travel"},"components":[{"name":"Travel Container","classes":["card-glow","travel-container"],"components":[{"name":"Section Header","classes":["section-header"],"components":[{"name":"Section Title Group","classes":["section-title-group"],"components":[{"tagName":"p","type":"text","name":"Section Eyebrow","classes":["section-eyebrow"],"components":[{"type":"textnode","content":"Travel"}]},{"tagName":"h2","type":"heading","name":"Section Title","classes":["gjs-t-h2","section-title"],"components":[{"type":"textnode","content":"Upcoming travel, conferences, and visits"}]},{"tagName":"p","type":"text","name":"Section Description","classes":["section-description"],"components":[{"type":"textnode","content":"Add conferences, invited talks, archive trips, visiting fellowships, workshops, or lecture travel here."}]}]},{"type":"text","name":"Travel Status","classes":["travel-status"],"components":[{"type":"textnode","content":"Open for updates"}]}]},{"name":"Travel Grid","classes":["travel-grid"],"components":[{"name":"Travel Card","classes":["travel-card"],"components":[{"tagName":"p","type":"text","name":"Travel Label","classes":["travel-label"],"components":[{"type":"textnode","content":"Upcoming"}]},{"tagName":"h3","type":"heading","name":"Travel Title","classes":["travel-title"],"components":[{"type":"textnode","content":"City or institution"}]},{"tagName":"p","type":"text","name":"Travel Date","classes":["travel-date"],"components":[{"type":"textnode","content":"Month Year"}]},{"tagName":"p","type":"text","name":"Travel Description","classes":["travel-description"],"components":[{"type":"textnode","content":"Add talk title, event name, archive visit, or collaborative meeting."}]}]},{"name":"Travel Card","classes":["travel-card"],"components":[{"tagName":"p","type":"text","name":"Travel Label","classes":["travel-label"],"components":[{"type":"textnode","content":"Conference"}]},{"tagName":"h3","type":"heading","name":"Travel Title","classes":["travel-title"],"components":[{"type":"textnode","content":"Conference or workshop"}]},{"tagName":"p","type":"text","name":"Travel Date","classes":["travel-date"],"components":[{"type":"textnode","content":"Month Year"}]},{"tagName":"p","type":"text","name":"Travel Description","classes":["travel-description"],"components":[{"type":"textnode","content":"Include panel participation, paper title, or organizer details."}]}]},{"name":"Travel Card","classes":["travel-card"],"components":[{"tagName":"p","type":"text","name":"Travel Label","classes":["travel-label"],"components":[{"type":"textnode","content":"Visit"}]},{"tagName":"h3","type":"heading","name":"Travel Title","classes":["travel-title"],"components":[{"type":"textnode","content":"Research or invited visit"}]},{"tagName":"p","type":"text","name":"Travel Date","classes":["travel-date"],"components":[{"type":"textnode","content":"Month Year"}]},{"tagName":"p","type":"text","name":"Travel Description","classes":["travel-description"],"components":[{"type":"textnode","content":"Use this for fellowships, talks, departmental visits, or field research travel."}]}]}]}]}]}]}]},{"type":"script","components":[{"type":"textnode","content":"\n    (function () {\n      const cards = document.querySelectorAll('.research-card');\n      cards.forEach(function(card) {\n        const toggle = card.querySelector('button');\n        function onToggle() {\n          card.classList.toggle('open');\n        }\n        toggle.addEventListener('click', onToggle);\n        card.addEventListener('keydown', function(e) {\n          if (e.key === 'Enter' || e.key === ' ') {\n            e.preventDefault();\n            onToggle();\n          }\n        });\n      });\n\n      const sections = document.querySelectorAll('section[id]');\n      const links = document.querySelectorAll('.nav-link');\n\n      function updateActiveLink() {\n        let current = '';\n        const offset = 160;\n        sections.forEach(function(section) {\n          const top = section.offsetTop - offset;\n          const bottom = top + section.offsetHeight;\n          if (window.scrollY >= top && window.scrollY < bottom) {\n            current = section.getAttribute('id');\n          }\n        });\n        links.forEach(function(link) {\n          const target = link.getAttribute('href').replace('#', '');\n          if (target === current) {\n            link.classList.add('nav-active');\n          } else {\n            link.classList.remove('nav-active');\n          }\n        });\n      }\n\n      updateActiveLink();\n      window.addEventListener('scroll', updateActiveLink);\n    })();\n  "}]}],"doctype":"<!DOCTYPE html>","head":{"type":"head","components":[{"tagName":"meta","void":true,"attributes":{"charset":"UTF-8"}},{"tagName":"meta","void":true,"attributes":{"name":"viewport","content":"width=device-width, initial-scale=1.0"}},{"tagName":"title","type":"text","components":[{"type":"textnode","content":"Academic Profile"}]},{"tagName":"link","void":true,"attributes":{"rel":"preconnect","href":"https://fonts.googleapis.com"}},{"tagName":"link","void":true,"attributes":{"rel":"preconnect","href":"https://fonts.gstatic.com","crossorigin":""}},{"tagName":"link","void":true,"attributes":{"href":"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap","rel":"stylesheet"}}]},"docEl":{"tagName":"html","attributes":{"lang":"en"}}},"id":"Maty7tP79lIyyrIH","minHeight":"500px"}],"id":"kNibowDmh0sv0GmO"}],"symbols":[],"custom":{"projectType":"web","id":""}}