cument.querySelectorAll('.nav-link');\n\n        function updateActiveLink() {\n          let current = '';\n          const offset = 160;\n          sections.forEach(function(section) {\n            const top = section.offsetTop - offset;\n            const bottom = top + section.offsetHeight;\n            if (window.scrollY >= top && window.scrollY < bottom) {\n              current = section.getAttribute('id');\n            }\n          });\n          links.forEach(function(link) {\n            const target = link.getAttribute('href').replace('#', '');\n            if (target === current) {\n              link.classList.add('nav-active');\n            } else {\n              link.classList.remove('nav-active');\n            }\n          });\n        }\n\n        updateActiveLink();\n        window.addEventListener('scroll', updateActiveLink);\n      })();\n    "}]}],"doctype":"<!DOCTYPE html>","head":{"type":"head","components":[{"type":"textnode","content":" "},{"type":"script","attributes":{"async":true,"src":"https://www.googletagmanager.com/gtag/js?id=G-95N3BKEJCM"}},{"type":"script","components":[{"type":"textnode","content":"\n  window.dataLayer = window.dataLayer || [];\n  function gtag(){dataLayer.push(arguments);}\n  gtag('js', new Date());\n\n  gtag('config', 'G-95N3BKEJCM');\n"}]},{"tagName":"title","type":"text","components":[{"type":"textnode","content":"Academic Profile"}]},{"tagName":"meta","void":true,"attributes":{"charset":"UTF-8"}},{"tagName":"meta","void":true,"attributes":{"name":"viewport","content":"width=device-width, initial-scale=1.0"}},{"tagName":"meta","void":true,"attributes":{"name":"robots","content":"index,follow"}},{"tagName":"meta","void":true,"attributes":{"name":"generator","content":"GrapesJS Studio"}},{"type":"script","attributes":{"async":true,"src":"https://www.googletagmanager.com/gtag/js?id=G-95N3BKEJCM"}},{"type":"script","components":[{"type":"textnode","content":"\n      window.dataLayer = window.dataLayer || [];\n\n      function gtag() {\n        dataLayer.push(arguments);\n      }\n      gtag('js', new Date());\n\n      gtag('config', 'G-95N3BKEJCM');\n    "}]},{"tagName":"link","void":true,"attributes":{"rel":"preconnect","href":"https://fonts.googleapis.com"}},{"tagName":"link","void":true,"attributes":{"rel":"preconnect","href":"https://fonts.gstatic.com","crossorigin":""}},{"tagName":"link","void":true,"attributes":{"href":"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Noto+Sans+Bengali:wght@400;500;600;700&display=swap","rel":"stylesheet","id":"im5ge"}}]},"docEl":{"tagName":"html","attributes":{"lang":"en"}}},"id":"Maty7tP79lIyyrIH","minHeight":"500px"}],"id":"kNibowDmh0sv0GmO"}],"symbols":[],"custom":{"projectType":"web","id":""}}